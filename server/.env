# Ruta absoluta de la carpeta de las bases de datos
DIR_BBDD=../bbdd

# Nombres exactos de las Bases de Datos
NAME_DB_RRHH=rrhh
NAME_DB_TIENDA=tienda

# Credenciales de los usuarios
DB_ADMIN_USER=asir_admin
DB_ADMIN_PASS=AdminContrasenaSegura2026*

DB_LIMIT_USER=asir_user
DB_LIMIT_PASS=UserContrasenaSegura2026*

# Archivos físicos con su extensión .sql
SQL_RRHH=database_rrhh.sql
SQL_TIENDA=database_tienda.sql

# Ruta relativa o absoluta donde se guardará la copia
BACKUP_DIR="../backup"
# Nombre fijo del archivo de copia (sin fechas, se sobrescribe siempre)
BACKUP_NAME="db_completa.sql.gz"

#IP publica del router
IP_PUBLICA=192.168.1.1

#Configuración de zabbix
ZABBIX_SERVER_IP="127.0.0.1" 
MONITORED_HOSTNAME="Servidor-TFG-Pedro"
# VARIABLES DE CONFIGURACIÓN DE VERSIÓN
ZABBIX_VER="7.0"
OS_VER="24.04"
# Parámetros internos para la base de datos de Zabbix
Z_DB_NAME="zabbix_db"
Z_DB_USER="zabbix_user"
Z_DB_PASS="PedroZabbix2026*" # Contraseña segura para el motor de Zabbix

#Variables de configuración para las pruebas de rendimiento
WEB_URL="http://localhost"
MYSQL_SERVICE="mysql"
APACHE_SERVICE="apache2"
LOG_DIR="../logs"
LOG_FILE="$LOG_DIR/resultado_pruebas.log"

# Variables de configuración para el script de iptables
IP_SERVIDOR_AWS="100.51.26.144"
IP="" 

