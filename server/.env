# =====================================================
# CONFIGURACIÓN GENERAL DE MYSQL
# =====================================================

# Ruta absoluta de la carpeta de las bases de datos
DIR_BBDD=../bbdd

# Nombres exactos de las Bases de Datos
NAME_DB_RRHH=rrhh
NAME_DB_TIENDA=tienda

# Credenciales de los usuarios
DB_ADMIN_USER=asir_admin
DB_ADMIN_PASS=AdminContrasenaSegura2026*

DB_LIMIT_USER=asir_user
DB_LIMIT_PASS=UserContrasenaSegura2026*

# Archivos físicos con su extensión .sql
SQL_RRHH=rrhh.sql
SQL_TIENDA=tienda.sql

# Ruta relativa o absoluta donde se guardará la copia
BACKUP_DIR="../backup"
# Nombre fijo del archivo de copia (sin fechas, se sobrescribe siempre)
BACKUP_NAME="db_completa.sql.gz"